# ==========================================
# EDOOFA VOICETRACK — ENVIRONMENT VARIABLES
# Copy this to .env and fill in values
# See SETUP_GUIDE below for how to get each key
# ==========================================

# ---- GROQ AI (Free — get at console.groq.com) ----
# Used for: Whisper transcription + Llama-3 summarization
# Cost: 100% FREE forever
GROQ_API_KEY=gsk_your_groq_key_here

# ---- GOOGLE SHEETS (Free — service account) ----
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_IS_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=voicetrack@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- SERVER ----
PORT=3000
NODE_ENV=production

# ---- WHATSAPP SESSION ----
# Leave this as-is — session auto-saves after first QR scan
WHATSAPP_SESSION_PATH=./whatsapp-session
